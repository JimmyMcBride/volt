{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volt.dev/schema/benchmark/report-v1.schema.json",
  "title": "report-v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "namespaces",
    "decision",
    "complexityGuardrails",
    "compositeScore"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "namespaces": {
      "type": "object"
    },
    "decision": {
      "type": "object"
    },
    "complexityGuardrails": {
      "type": "array"
    },
    "compositeScore": {
      "type": "null"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
