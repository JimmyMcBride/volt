{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volt.dev/schema/benchmark/invariant-manifest-v1.schema.json",
  "title": "invariant-manifest-v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "taskId",
    "invariants"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "type": "string"
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
