{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volt.dev/schema/benchmark/authorization-v1.schema.json",
  "title": "authorization-v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "phase",
    "approved",
    "owner",
    "maximumSpendUsd"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "phase": {
      "enum": [
        "calibration",
        "confirmatory"
      ]
    },
    "approved": {
      "type": "boolean"
    },
    "owner": {
      "type": "string"
    },
    "maximumSpendUsd": {
      "type": "number",
      "minimum": 0
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
