{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volt.dev/schema/benchmark/analysis-v1.schema.json",
  "title": "analysis-v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "comparisons",
    "operationalMeasurements"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "comparisons": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "operationalMeasurements": {
      "type": "object"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
