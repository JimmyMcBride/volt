{
  "name": "volt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "volt": "dist/toolchain/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm run check:research && npm run check:language && node toolchain/scripts/validate.mjs && node benchmark/scripts/validate.mjs",
    "check:research": "node research/scripts/validate.mjs",
    "check:language": "node language/scripts/validate.mjs",
    "check:toolchain": "npm run build && node toolchain/scripts/validate.mjs",
    "check:benchmark": "npm run build && node benchmark/scripts/validate.mjs",
    "benchmark:generate": "node benchmark/scripts/generate-corpus.mjs",
    "benchmark:offline": "npm run build && node benchmark/scripts/run.mjs offline",
    "benchmark:calibration:dry-run": "npm run build && node benchmark/scripts/dry-run-live.mjs",
    "benchmark:calibration:preflight": "npm run build && node benchmark/scripts/preflight-live.mjs",
    "benchmark:calibration:approval-packet": "npm run build && node benchmark/scripts/build-run-approval.mjs",
    "benchmark:calibrate": "npm run build && node benchmark/scripts/run.mjs calibration",
    "benchmark:confirmatory": "npm run build && node benchmark/scripts/run.mjs confirmatory",
    "test": "npm run build && node --test",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  }
}
