{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volt.dev/schema/benchmark/model-v1.schema.json",
  "title": "model-v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "models"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "models": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
