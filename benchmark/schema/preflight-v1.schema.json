{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volt.dev/schema/benchmark/preflight-v1.schema.json",
  "title": "preflight-v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "provider",
    "modelId",
    "inferenceAuthorized",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "provider": {
      "enum": [
        "openai",
        "novita"
      ]
    },
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "inferenceAuthorized": {
      "type": "boolean"
    },
    "evidence": {
      "type": "object"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
