{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volt.dev/schema/benchmark/spend-ledger-v1.schema.json",
  "title": "spend-ledger-v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "maximumSpendUsd",
    "spentUsd",
    "ambiguousReservedUsd",
    "requestCeiling",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "maximumSpendUsd": {
      "type": "number",
      "minimum": 0
    },
    "spentUsd": {
      "type": "number",
      "minimum": 0
    },
    "ambiguousReservedUsd": {
      "type": "number",
      "minimum": 0
    },
    "requestCeiling": {
      "const": 640
    },
    "entries": {
      "type": "array"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
