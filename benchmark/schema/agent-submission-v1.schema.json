{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volt.dev/schema/benchmark/agent-submission-v1.schema.json",
  "title": "agent-submission-v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
