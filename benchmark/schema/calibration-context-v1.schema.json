{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volt.dev/schema/benchmark/calibration-context-v1.schema.json",
  "title": "calibration-context-v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "allowedCorpus",
    "allowedTaskIds",
    "tasks",
    "deniedTaskIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "allowedCorpus": {
      "const": "calibration"
    },
    "allowedTaskIds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "deniedTaskIds": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
